{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "posterlight",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 8686
    },
    {
      "name": "posterlight-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PLEX_URL=http://127.0.0.1:9",
        "PLEX_TOKEN=demo-preview-only",
        "PORT=8687",
        "node",
        "server.js"
      ],
      "port": 8687
    },
    {
      "name": "posterlight-site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "var h=require('http'),f=require('fs'),p=require('path'),r=p.resolve('docs'),t={'.html':'text/html','.css':'text/css','.js':'application/javascript','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.woff2':'font/woff2','.woff':'font/woff','.webmanifest':'application/manifest+json'};h.createServer(function(q,s){var u=decodeURIComponent(q.url.split('?')[0]);if(u.slice(-1)==='/')u+='index.html';var x=p.resolve(r,'.'+u);if(x.indexOf(r)!==0){s.writeHead(404);return s.end()}f.readFile(x,function(e,b){if(e){s.writeHead(404);return s.end('not found')}s.writeHead(200,{'Content-Type':t[p.extname(x)]||'application/octet-stream'});s.end(b)})}).listen(8690)"
      ],
      "port": 8690
    }
  ]
}
