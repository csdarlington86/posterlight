# PosterLight settings as environment variables.
#
# Most people do not need this file: start PosterLight and use the setup page instead.
# Use it for Docker, a NAS, or a server with no screen.
#
# 1. Copy this file to ".env".
# 2. Fill in the values.
# 3. Start with one of:
#      node --env-file=.env server.js            (Node.js 20.6 or later)
#      docker run --env-file .env -p 8686:8686 posterlight
#
# Never share or commit your .env file. It holds your Plex token.

# The address of your Plex Media Server, as seen from the helper computer.
PLEX_URL=http://192.168.1.10:32400

# Your Plex token. The README section "Enter the address and token by hand" shows how to find it.
PLEX_TOKEN=PUT-TOKEN-HERE

# The port the helper listens on.
PORT=8686

# Optional. Where settings and state are kept. Docker sets these to /data.
# POSTERLIGHT_CONFIG=/path/to/config.json
# POSTERLIGHT_DATA=/path/to/data
